# Postgres — set automatically when you link a Postgres storage integration
# (Storage tab -> Create Database -> Postgres) to this Vercel project.
DATABASE_URL=

# Google Sheets two-way sync (optional — without these the app works on its own).
# GOOGLE_SERVICE_ACCOUNT_JSON: the whole downloaded service-account key file, pasted as one value.
# SHEET_ID: the ID in the sheet's URL (docs.google.com/spreadsheets/d/<ID>/edit).
# SHEET_SYNC_SECRET: any long random string; the same value goes in the Apps Script (apps-script/SheetSync.gs).
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
SHEET_SYNC_SECRET=

# Required — Google Sign-In. Create an OAuth 2.0 Client ID (type: Web
# application) in Google Cloud Console and add this app's callback URL
# (https://<your-domain>/api/auth/callback/google) as an authorized redirect
# URI. See README.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required — NextAuth session encryption. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Required in production — the app's own public URL, e.g.
# https://stayvista-onboarding-ledger.vercel.app
NEXTAUTH_URL=
